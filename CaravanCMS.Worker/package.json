{
  "name": "caravancms-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply caravancms --local",
    "d1:migrate:remote": "wrangler d1 migrations apply caravancms --remote",
    "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.4.0",
    "exceljs": "^4.4.0",
    "fuzzball": "^2.1.3",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "better-sqlite3": "^13.0.3",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "wrangler": "^4.20.0"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260804.1": true,
    "better-sqlite3@13.0.3": true
  }
}
