<Window x:Class="CaravanCMS.Client.Views.CaravanDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CaravanCMS.Client.Views"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        Title="Caravan History"
        Height="780" Width="1050"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:NullToVisibilityConverter x:Key="NullToVis"/>
        <local:MimeTypeToIconConverter x:Key="MimeToIcon"/>
        <local:ZeroToVisibilityConverter x:Key="ZeroToVis"/>
        <local:NonZeroToVisibilityConverter x:Key="NonZeroToVis"/>
        <local:EqualityToVisibilityConverter x:Key="EqualityToVis"/>
        <local:CategoryGroupNameConverter x:Key="CategoryGroupName"/>
        <CollectionViewSource x:Key="GroupedDocs" Source="{Binding Documents}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="DocumentType"/>
                <!-- Category holds the source import folder ("2024 - Roger Kidd") — sub-grouping on it
                     bundles a job's PDF and photos together instead of listing them as unrelated rows. -->
                <PropertyGroupDescription PropertyName="Category" Converter="{StaticResource CategoryGroupName}"/>
            </CollectionViewSource.GroupDescriptions>
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="DocumentType"/>
                <scm:SortDescription PropertyName="Category"/>
                <scm:SortDescription PropertyName="UploadedDate" Direction="Descending"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- ── Header band ─────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource DeepPink}" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="White">
                        <Run Text="{Binding Caravan.Year, FallbackValue=''}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Caravan.Make, FallbackValue=''}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Caravan.Model, FallbackValue='Caravan Detail'}"/>
                    </TextBlock>
                    <TextBlock FontFamily="Segoe UI" FontSize="12" Foreground="#FFDDEE">
                        <Run Text="Rego: "/>
                        <Run Text="{Binding Caravan.RegistrationNumber, FallbackValue='—'}"/>
                        <Run Text="   VIN: "/>
                        <Run Text="{Binding Caravan.Vin, FallbackValue='—'}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Caravan.Customer.Name, FallbackValue=''}"
                               FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding Caravan.Customer.Phone, FallbackValue=''}"
                               FontFamily="Segoe UI" FontSize="12" Foreground="#FFDDEE"
                               HorizontalAlignment="Right"/>
                </StackPanel>
                <Button Grid.Column="2" Content="📦 Package and Send" Margin="20,0,0,0"
                        VerticalAlignment="Center" Style="{StaticResource HeaderButton}"
                        Click="PackageAndSend_Click"/>
            </Grid>
        </Border>

        <!-- ── Tab content ─────────────────────────────────────────────────── -->
        <TabControl Grid.Row="1" Style="{StaticResource PinkTabControl}" Margin="20,12,20,0">

            <!-- Info tab -->
            <TabItem Header="  Vehicle Info  " Style="{StaticResource PinkTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Vehicle details (editable) -->
                                <StackPanel>
                                    <TextBlock Text="Vehicle Details" Style="{StaticResource HeadingMedium}" Margin="0,0,0,12"/>
                                    <StackPanel>
                                        <TextBlock Text="Registration" Style="{StaticResource SubText}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding Caravan.RegistrationNumber}"
                                                   FontFamily="Segoe UI" FontSize="28" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                                        <TextBlock Text="Make" Style="{StaticResource SubText}" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding Caravan.Make, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputBox}" Margin="0,0,0,10"/>

                                        <TextBlock Text="Model" Style="{StaticResource SubText}" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding Caravan.Model, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputBox}" Margin="0,0,0,10"/>

                                        <TextBlock Text="Year" Style="{StaticResource SubText}" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding Caravan.Year, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputBox}" Margin="0,0,0,10"/>

                                        <TextBlock Text="VIN / Chassis" Style="{StaticResource SubText}" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding Caravan.Vin, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputBox}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Owner details -->
                                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                    <TextBlock Text="Owner Details" Style="{StaticResource HeadingMedium}" Margin="0,0,0,12"/>
                                    <StackPanel>
                                        <local:InfoRow Label="Name" Value="{Binding Caravan.Customer.Name}"/>
                                        <local:InfoRow Label="Email" Value="{Binding Caravan.Customer.Email}"/>
                                        <local:InfoRow Label="Phone" Value="{Binding Caravan.Customer.Phone}"/>
                                        <local:InfoRow Label="Mobile" Value="{Binding Caravan.Customer.Mobile}"/>
                                        <local:InfoRow Label="Address" Value="{Binding Caravan.Customer.Address}"/>
                                        <local:InfoRow Label="Suburb" Value="{Binding Caravan.Customer.Suburb}"/>
                                        <local:InfoRow Label="State" Value="{Binding Caravan.Customer.State}"/>
                                        <local:InfoRow Label="Postcode" Value="{Binding Caravan.Customer.Postcode}"/>
                                        <local:InfoRow Label="Customer #" Value="{Binding Caravan.Customer.CustomerNumber}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Certifications & keys (editable) -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Warrant of Fitness" Style="{StaticResource HeadingMedium}" Margin="0,0,0,12"/>
                                    <TextBlock Text="Issue Date" Style="{StaticResource SubText}" Margin="0,0,0,2"/>
                                    <DatePicker x:Name="WofIssueDatePicker" SelectedDate="{Binding Caravan.WofIssueDate}"
                                                Margin="0,0,0,10" HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="Due Date" Style="{StaticResource SubText}" Margin="0,0,0,2"/>
                                    <DatePicker SelectedDate="{Binding Caravan.WofDueDate}" HorizontalAlignment="Stretch"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                    <TextBlock Text="Warrant of Electrical Fitness" Style="{StaticResource HeadingMedium}" Margin="0,0,0,12"/>
                                    <TextBlock Text="Issue Date" Style="{StaticResource SubText}" Margin="0,0,0,2"/>
                                    <DatePicker x:Name="ElectricalWofIssueDatePicker" SelectedDate="{Binding Caravan.ElectricalWofIssueDate}"
                                                Margin="0,0,0,10" HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="Due Date" Style="{StaticResource SubText}" Margin="0,0,0,2"/>
                                    <DatePicker SelectedDate="{Binding Caravan.ElectricalWofDueDate}" HorizontalAlignment="Stretch"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="24,0,0,0">
                                    <TextBlock Text="Self Containment" Style="{StaticResource HeadingMedium}" Margin="0,0,0,12"/>
                                    <TextBlock Text="Issue Date" Style="{StaticResource SubText}" Margin="0,0,0,2"/>
                                    <DatePicker x:Name="SelfContainmentIssueDatePicker" SelectedDate="{Binding Caravan.SelfContainmentIssueDate}"
                                                Margin="0,0,0,10" HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="Due Date" Style="{StaticResource SubText}" Margin="0,0,0,2"/>
                                    <DatePicker SelectedDate="{Binding Caravan.SelfContainmentDue}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Keys -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Locker Key Number" Style="{StaticResource SubText}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding Caravan.LockerKeyNumber, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                    <TextBlock Text="Door Key Number" Style="{StaticResource SubText}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding Caravan.DoorKeyNumber, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputBox}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Notes -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Notes" Style="{StaticResource HeadingMedium}" Margin="0,0,0,12"/>
                                <TextBox Text="{Binding Caravan.Notes, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputBox}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Height="140" VerticalContentAlignment="Top"/>
                            </StackPanel>
                        </Border>

                        <!-- Save -->
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Center">
                            <Button Content="Save Vehicle Info" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveVehicleInfoCommand}"
                                    Padding="20,8"/>
                            <TextBlock Text="{Binding VehicleInfoStatus}" Style="{StaticResource SubText}"
                                       Margin="16,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Job History tab -->
            <TabItem Style="{StaticResource PinkTabItem}">
                <TabItem.Header>
                    <TextBlock>
                        <Run Text="  Job History  "/>
                        <Run Text="{Binding Jobs.Count, StringFormat='({0})', Mode=OneWay}"
                             Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    </TextBlock>
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10"
                                Visibility="{Binding Jobs.Count, Converter={StaticResource NonZeroToVis}}">
                        <Button FontSize="12"
                                Command="{Binding ToggleJobSortCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Content" Value="⬇ Newest first"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding JobsNewestFirst}" Value="False">
                                            <Setter Property="Content" Value="⬆ Oldest first"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding VisibleJobs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Timeline dot -->
                                    <Ellipse Width="12" Height="12" Fill="{StaticResource PrimaryPink}"
                                             VerticalAlignment="Top" Margin="2,8,0,0"/>

                                    <!-- Job card -->
                                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource HeadingMedium}">
                                                        <Run Text="Job #"/>
                                                        <Run Text="{Binding JobNumber}"/>
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource SubText}" Margin="0,2,0,0">
                                                        <Run Text="{Binding JobType}"/>
                                                        <Run Text=" · Completed "/>
                                                        <Run Text="{Binding FinishDate, StringFormat='dd MMM yyyy'}"/>
                                                        <Run Text=" · By "/>
                                                        <Run Text="{Binding FinishedBy}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <!-- Status badge -->
                                                <Border Grid.Column="1" CornerRadius="10" Padding="10,4"
                                                        Background="#E0F0E8" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{StaticResource SuccessBrush}"/>
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}"
                                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                                       Visibility="{Binding Description, Converter={StaticResource NullToVis}}"/>

                                            <TextBlock Text="{Binding Notes}" Style="{StaticResource SubText}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" FontStyle="Italic"
                                                       Visibility="{Binding Notes, Converter={StaticResource NullToVis}}"/>

                                            <!-- Invoices for this job -->
                                            <ItemsControl ItemsSource="{Binding Invoices}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource BorderPink}"
                                                                BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,4,0,0">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource BodyText}">
                                                                    <Run Text="Invoice #" FontWeight="SemiBold"/>
                                                                    <Run Text="{Binding InvoiceNumber}" FontWeight="SemiBold"/>
                                                                    <Run Text="  "/>
                                                                    <Run Text="{Binding IssueDate, StringFormat='dd MMM yyyy'}"
                                                                         Foreground="{StaticResource TextSecondary}"/>
                                                                </TextBlock>
                                                                <!-- Line items -->
                                                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,0">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,2">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="50"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{Binding Description}"
                                                                                           Style="{StaticResource SubText}"/>
                                                                                <TextBlock Grid.Column="1" Style="{StaticResource SubText}"
                                                                                           Text="{Binding Quantity}"
                                                                                           HorizontalAlignment="Center"/>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Documents tab -->
            <TabItem Style="{StaticResource PinkTabItem}">
                <TabItem.Header>
                    <TextBlock>
                        <Run Text="  Documents  "/>
                        <Run Text="{Binding Documents.Count, StringFormat='({0})', Mode=OneWay}"
                             Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    </TextBlock>
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10"
                                Visibility="{Binding Documents.Count, Converter={StaticResource NonZeroToVis}}">
                        <Button Content="⬇ Newest first" FontSize="12" Style="{StaticResource SecondaryButton}"
                                Click="ToggleDocumentSort_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="No documents linked to this caravan."
                               Style="{StaticResource SubText}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="14"
                               Visibility="{Binding Documents.Count, Converter={StaticResource ZeroToVis}}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedDocs}}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="{x:Type GroupItem}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                                        <!-- Collapsed by default so staff can jump straight to the
                                                             document type (Major Jobs, Self Containment, etc.)
                                                             they're after instead of scrolling past everything.
                                                             Header count is Items.Count, not ItemCount — this
                                                             group's immediate children are the Category subgroups
                                                             (one per job/quote folder), and ItemCount would instead
                                                             give the total file count recursed across all of them. -->
                                                        <Expander IsExpanded="False" Margin="0,10,0,0">
                                                            <Expander.Header>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Foreground="{StaticResource DeepPink}"
                                                                               FontSize="13" FontWeight="SemiBold"
                                                                               VerticalAlignment="Center">
                                                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                                                        <Run Text=" ("/>
                                                                        <Run Text="{Binding Items.Count, Mode=OneWay}"/>
                                                                        <Run Text=")"/>
                                                                    </TextBlock>
                                                                    <Button Content="✉ Send a Copy" FontSize="11" Margin="12,0,0,0"
                                                                            Style="{StaticResource SecondaryButton}" Padding="8,3"
                                                                            Tag="{Binding Name}"
                                                                            Click="SendDocumentTypeCopy_Click"/>
                                                                </StackPanel>
                                                            </Expander.Header>
                                                            <ItemsPresenter Margin="0,8,0,0"/>
                                                        </Expander>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                                <!-- Level 2: Category (the source import folder) — bundles a job's PDF and
                                     photos into one visually-boxed unit instead of a flat file list. Not
                                     independently collapsible; the type-level Expander above already hides
                                     it until wanted. -->
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="{x:Type GroupItem}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                                        <Border Background="{StaticResource LightPink}"
                                                                BorderBrush="{StaticResource BorderPink}" BorderThickness="1"
                                                                CornerRadius="4" Padding="10,8" Margin="0,6,0,0">
                                                            <StackPanel>
                                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextSecondary}"
                                                                           Margin="0,0,0,6">
                                                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                                                    <Run Text=" · "/>
                                                                    <Run Text="{Binding ItemCount, Mode=OneWay}"/>
                                                                    <Run Text=" file(s)"/>
                                                                </TextBlock>
                                                                <ItemsPresenter/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Thumbnail / placeholder -->
                                            <Border Width="150" Height="110"
                                                    Background="{StaticResource LightPink}"
                                                    BorderBrush="{StaticResource BorderPink}" BorderThickness="1"
                                                    CornerRadius="4" Margin="0,0,14,0" VerticalAlignment="Center"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <!-- Real thumbnail (images and PDFs) -->
                                                    <Image Source="{Binding ThumbnailSource}"
                                                           Stretch="UniformToFill"
                                                           Visibility="{Binding HasThumbnail,
                                                               Converter={StaticResource BoolToVis}}"/>
                                                    <!-- Emoji placeholder while not yet loaded -->
                                                    <TextBlock Text="{Binding MimeType, Converter={StaticResource MimeToIcon}}"
                                                               FontSize="38"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}"
                                                           Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                                                <TextBlock Style="{StaticResource SubText}" Margin="0,3,0,0">
                                                    <Run Text="Added "/>
                                                    <Run Text="{Binding UploadedDate, StringFormat='dd MMM yyyy', Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Notes}" Style="{StaticResource SubText}"
                                                           FontStyle="Italic"
                                                           Visibility="{Binding Notes, Converter={StaticResource NullToVis}}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                <Button Style="{StaticResource SecondaryButton}"
                                                        Content="👁  View" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.ViewDocumentCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource PrimaryButton}"
                                                        Content="⬇  Save"
                                                        Command="{Binding DataContext.SaveDocumentCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <!-- Conversations tab -->
            <TabItem Style="{StaticResource PinkTabItem}">
                <TabItem.Header>
                    <TextBlock>
                        <Run Text="  Conversations  "/>
                        <Run Text="{Binding Conversations.Count, StringFormat='({0})', Mode=OneWay}"
                             Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    </TextBlock>
                </TabItem.Header>

                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Log a call, note, meeting, or manual email — so phone/in-person contact isn't lost -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Log a call or note" Style="{StaticResource HeadingMedium}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource InputBox}" Margin="0,0,8,0"
                                         Text="{Binding NewSubject, UpdateSourceTrigger=PropertyChanged}"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding NewType}"
                                          Margin="0,0,8,0" Padding="8,5" FontFamily="Segoe UI" FontSize="13"/>
                                <ComboBox Grid.Column="2" ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding NewDirection}"
                                          Padding="8,5" FontFamily="Segoe UI" FontSize="13"/>
                            </Grid>
                            <TextBox Style="{StaticResource InputBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                     Height="60" Margin="0,0,0,8"
                                     Text="{Binding NewBody, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Log Conversation"
                                    Command="{Binding LogConversationCommand}" HorizontalAlignment="Left" MinWidth="150"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="1" Text="No conversations logged for this customer."
                               Style="{StaticResource SubText}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="14"
                               Visibility="{Binding Conversations.Count, Converter={StaticResource ZeroToVis}}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10"
                                        Visibility="{Binding Conversations.Count, Converter={StaticResource NonZeroToVis}}">
                                <Button FontSize="12"
                                        Command="{Binding ToggleConversationSortCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Setter Property="Content" Value="⬇ Newest first"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConversationsNewestFirst}" Value="False">
                                                    <Setter Property="Content" Value="⬆ Oldest first"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <!-- Active filter banner -->
                            <Border Background="{StaticResource LightPink}" CornerRadius="4" Padding="10,6" Margin="0,0,0,10"
                                    Visibility="{Binding ActiveTagFilter, Converter={StaticResource NullToVis}}">
                                <TextBlock FontSize="12" Foreground="{StaticResource DeepPink}">
                                    <Run Text="Showing conversations tagged "/>
                                    <Run Text="{Binding ActiveTagFilter, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text=" — click the tag again to clear."/>
                                </TextBlock>
                            </Border>

                            <ItemsControl ItemsSource="{Binding VisibleConversations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Cursor="Hand">
                                                        <StackPanel.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.ToggleConversationExpandCommand,
                                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}"/>
                                                        </StackPanel.InputBindings>
                                                        <TextBlock Text="{Binding Subject, FallbackValue='(No subject)'}"
                                                                   Style="{StaticResource HeadingMedium}"/>
                                                        <TextBlock Style="{StaticResource SubText}" Margin="0,2,0,0">
                                                            <Run Text="{Binding Messages.Count, Mode=OneWay}"/>
                                                            <Run Text=" messages · last activity "/>
                                                            <Run Text="{Binding LastActivityAt, StringFormat='dd MMM yyyy'}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <Button Grid.Column="1" Content="✉ Send a Copy" FontSize="11" Margin="8,0"
                                                            Style="{StaticResource SecondaryButton}" Padding="8,3" VerticalAlignment="Top"
                                                            Tag="{Binding}" Click="SendConversationCopy_Click"/>

                                                    <!-- Tag chips -->
                                                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Tags}" VerticalAlignment="Top">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border CornerRadius="10" Padding="10,4" Margin="4,0,0,0"
                                                                        Background="{StaticResource LightPink}"
                                                                        BorderBrush="{StaticResource BorderPink}" BorderThickness="1"
                                                                        Cursor="Hand">
                                                                    <Border.InputBindings>
                                                                        <MouseBinding MouseAction="LeftClick"
                                                                                      Command="{Binding DataContext.ToggleTagFilterCommand,
                                                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                      CommandParameter="{Binding Name}"/>
                                                                    </Border.InputBindings>
                                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource DeepPink}"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>

                                                <!-- Expanded messages (only for the currently-expanded conversation) -->
                                                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Messages}">
                                                    <ItemsControl.Visibility>
                                                        <MultiBinding Converter="{StaticResource EqualityToVis}" Mode="OneWay">
                                                            <Binding Path="."/>
                                                            <Binding Path="DataContext.ExpandedConversation"
                                                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        </MultiBinding>
                                                    </ItemsControl.Visibility>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource BorderPink}"
                                                                    BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,4,0,0">
                                                                <StackPanel>
                                                                    <TextBlock Style="{StaticResource SubText}">
                                                                        <Run Text="{Binding Direction}" FontWeight="SemiBold">
                                                                            <Run.Style>
                                                                                <Style TargetType="Run">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Direction}" Value="Outbound">
                                                                                            <Setter Property="Foreground" Value="{StaticResource DeepPink}"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Direction}" Value="Inbound">
                                                                                            <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Run.Style>
                                                                        </Run>
                                                                        <Run Text=" · "/>
                                                                        <Run Text="{Binding FromAddress}"/>
                                                                        <Run Text=" · "/>
                                                                        <Run Text="{Binding OccurredAt, StringFormat='dd MMM yyyy HH:mm'}"/>
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding Body}" Style="{StaticResource BodyText}"
                                                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Add message to this conversation (only for the currently-expanded conversation) —
                                                     for a reply or supplier email that belongs with an existing thread rather than
                                                     starting a new one. -->
                                                <StackPanel Margin="0,10,0,0">
                                                    <StackPanel.Visibility>
                                                        <MultiBinding Converter="{StaticResource EqualityToVis}" Mode="OneWay">
                                                            <Binding Path="."/>
                                                            <Binding Path="DataContext.ExpandedConversation"
                                                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        </MultiBinding>
                                                    </StackPanel.Visibility>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="110"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox FontSize="12" Padding="6,4" Margin="0,0,6,0"
                                                                 Text="{Binding DataContext.NewMessageBody,
                                                                     RelativeSource={RelativeSource AncestorType=Window},
                                                                     UpdateSourceTrigger=PropertyChanged}"/>
                                                        <ComboBox Grid.Column="1" FontSize="12" Padding="6,4" Margin="0,0,6,0"
                                                                  ItemsSource="{Binding DataContext.TypeOptions,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  SelectedItem="{Binding DataContext.NewMessageType,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <ComboBox Grid.Column="2" FontSize="12" Padding="6,4"
                                                                  ItemsSource="{Binding DataContext.DirectionOptions,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  SelectedItem="{Binding DataContext.NewMessageDirection,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </Grid>
                                                    <Button Content="Add to this conversation" FontSize="12" HorizontalAlignment="Left"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Command="{Binding DataContext.AddMessageToConversationCommand,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </StackPanel>

                                                <!-- Add label (only for the currently-expanded conversation) -->
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <StackPanel.Visibility>
                                                        <MultiBinding Converter="{StaticResource EqualityToVis}" Mode="OneWay">
                                                            <Binding Path="."/>
                                                            <Binding Path="DataContext.ExpandedConversation"
                                                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        </MultiBinding>
                                                    </StackPanel.Visibility>
                                                    <TextBox Width="160" FontSize="12" VerticalContentAlignment="Center"
                                                             Text="{Binding DataContext.NewTagText,
                                                                 RelativeSource={RelativeSource AncestorType=Window},
                                                                 UpdateSourceTrigger=PropertyChanged}">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Key="Return"
                                                                        Command="{Binding DataContext.AddTagCommand,
                                                                            RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                    <Button Content="Add label" Margin="6,0,0,0" FontSize="12"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Command="{Binding DataContext.AddTagCommand,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource LightPink}"
                BorderBrush="{StaticResource BorderPink}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource SubText}"
                       Margin="16,0" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
