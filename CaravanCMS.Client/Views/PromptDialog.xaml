<Window x:Class="CaravanCMS.Client.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CaravanCMS" Height="220" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText" Grid.Row="0" Style="{StaticResource HeadingMedium}"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <TextBox x:Name="InputBox" Grid.Row="1" Style="{StaticResource InputBox}"
                 KeyDown="InputBox_KeyDown"/>

        <TextBlock x:Name="WarningText" Grid.Row="2" Style="{StaticResource SubText}"
                   Foreground="{StaticResource WarningBrush}" FontStyle="Italic"
                   TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                    Click="Cancel_Click" IsCancel="True"/>
            <Button x:Name="OkButton" Content="OK" Style="{StaticResource PrimaryButton}"
                    Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
