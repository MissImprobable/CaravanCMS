<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>CaravanCMS.Api</AssemblyName>
    <RootNamespace>CaravanCMS.Api</RootNamespace>
    <ApplicationIcon>Resources\api.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\api.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
    <!-- Overrides the vulnerable SQLitePCLRaw.lib.e_sqlite3 2.1.10 pulled in transitively by
         EFCore.Sqlite 9.0.0 (NU1903 / GHSA-2m69-gcr7-jv3q, CVE-2025-6965) with a patched build. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="EPPlus" Version="7.5.1" />
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CaravanCMS.Core\CaravanCMS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\api.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The self-signed HTTPS cert (generated by certs/New-CaravanCmsCertificate.ps1) must sit next
       to the running exe, since Kestrel:Endpoints:Https:Certificate:Path in appsettings.Production.json
       is a relative path. Wildcarded so this is a no-op on a fresh clone before the cert exists. -->
  <ItemGroup>
    <None Include="certs\*.pfx;certs\*.cer">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The SDK's static web assets system serves wwwroot from its source location during `dotnet run`,
       but doesn't physically copy it into a plain `dotnet build` output — only `dotnet publish` does
       that by default. Since the exe is run directly from bin/Debug here, force the copy explicitly
       so /addin/* (manifest, task pane) resolves correctly either way. -->
  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
