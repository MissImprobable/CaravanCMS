<Window x:Class="CaravanCMS.Admin.Views.DocumentReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CaravanCMS.Admin.ViewModels"
        Title="Review Documents"
        Height="680" Width="900"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Review Documents" Style="{StaticResource HeadingLarge}"/>
            <TextBlock Text="These files were found in the Caravan History folder but couldn't be confidently matched automatically. Pick the right caravan and link, or ignore files that don't belong in the system."
                       Style="{StaticResource SubText}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Status -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
            <StackPanel>
                <ProgressBar Style="{StaticResource PinkProgress}" Margin="0,0,0,8"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Results DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Style="{StaticResource SecondaryButton}" Content="Select All"
                            Command="{Binding SelectAllCommand}" Padding="10,5" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Select None"
                            Command="{Binding SelectNoneCommand}" Padding="10,5" Margin="0,0,12,0"/>
                    <TextBlock Style="{StaticResource SubText}" VerticalAlignment="Center"
                               Text="{Binding SelectedCount, StringFormat='{}{0} selected'}"/>
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Items}"
                          Style="{StaticResource PinkDataGrid}"
                          ColumnHeaderStyle="{StaticResource PinkDataGridColumnHeader}"
                          IsReadOnly="False">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Sel"
                                                Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                Width="40" IsReadOnly="False"/>
                        <DataGridTextColumn Header="File"          Binding="{Binding Doc.FileName}"  Width="160" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Source Folder" Binding="{Binding SourceFolder}"   Width="*"   IsReadOnly="True"/>

                        <!-- Caravan picker — shows any weak suggestion, always requires explicit confirm via selection -->
                        <DataGridTemplateColumn Header="Caravan" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SelectedDisplay}"
                                               VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedCaravan}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="— click to assign —"/>
                                                        <Setter Property="Foreground" Value="#AAAAAA"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.AllCaravans,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding SelectedCaravan, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="RegistrationNumber"
                                              IsEditable="False"
                                              IsDropDownOpen="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Guess"      Binding="{Binding Doc.MatchMethod}"      Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceDisplay}"    Width="75"  IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="Done"   Binding="{Binding IsResolved}"
                                                Width="50" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="🚫  Ignore Selected"
                    Command="{Binding IgnoreSelectedCommand}" Margin="0,0,10,0"/>
            <Button Style="{StaticResource PrimaryButton}" Content="🔗  Link Selected"
                    Command="{Binding LinkSelectedCommand}" Margin="0,0,10,0"/>
            <Button Style="{StaticResource SecondaryButton}" Content="Close"
                    IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
