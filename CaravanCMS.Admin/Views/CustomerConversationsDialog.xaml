<Window x:Class="CaravanCMS.Admin.Views.CustomerConversationsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CaravanCMS.Admin.Views"
        Title="Customer Conversations"
        Height="720" Width="900"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:NullToVisibilityConverter x:Key="NullToVis"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Customer Conversations" Style="{StaticResource HeadingLarge}"/>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource SubText}">
                Search for a customer to review their communication history, tag conversations by
                purpose, or log a call or note.
            </TextBlock>
        </StackPanel>

        <!-- Search -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" Margin="0,0,10,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Search"
                            Command="{Binding SearchCommand}" MinWidth="100"/>
                </Grid>

                <!-- Search results -->
                <ItemsControl ItemsSource="{Binding SearchResults}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource LightPink}" CornerRadius="4" Padding="10,6" Margin="0,0,0,4" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.SelectCustomerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <TextBlock FontSize="13">
                                    <Run Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <Run Text=" — "/>
                                    <Run Text="{Binding Email}" Foreground="{StaticResource TextSecondary}"/>
                                    <Run Text="  ·  "/>
                                    <Run Text="{Binding CaravanCount}"/>
                                    <Run Text=" caravan(s), "/>
                                    <Run Text="{Binding JobCount}"/>
                                    <Run Text=" job(s)"/>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Selected customer: conversations + log form -->
        <Grid Grid.Row="2" Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Customer header -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedCustomer.Name}" Style="{StaticResource HeadingMedium}"/>
                    <TextBlock Style="{StaticResource SubText}">
                        <Run Text="{Binding SelectedCustomer.Email}"/>
                        <Run Text="  ·  "/>
                        <Run Text="{Binding SelectedCustomer.Phone}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Log a new conversation -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Log a call or note" Style="{StaticResource HeadingMedium}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputBox}" Margin="0,0,8,0"
                                 Text="{Binding NewSubject, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding NewType}"
                                  Margin="0,0,8,0" Padding="8,5" FontFamily="Segoe UI" FontSize="13"/>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding NewDirection}"
                                  Padding="8,5" FontFamily="Segoe UI" FontSize="13"/>
                    </Grid>
                    <TextBox Style="{StaticResource InputBox}" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="60" Margin="0,0,0,8"
                             Text="{Binding NewBody, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Log Conversation"
                            Command="{Binding LogConversationCommand}" HorizontalAlignment="Left" MinWidth="150"/>
                </StackPanel>
            </Border>

            <!-- Conversation list -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Conversations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Cursor="Hand">
                                            <StackPanel.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleExpandCommand}"/>
                                            </StackPanel.InputBindings>
                                            <TextBlock Text="{Binding Dto.Subject, FallbackValue='(No subject)'}"
                                                       Style="{StaticResource HeadingMedium}"/>
                                            <TextBlock Style="{StaticResource SubText}" Margin="0,2,0,0">
                                                <Run Text="{Binding Dto.RegistrationNumber, FallbackValue='No caravan linked'}"/>
                                                <Run Text="  ·  "/>
                                                <Run Text="{Binding Messages.Count, Mode=OneWay}"/>
                                                <Run Text=" message(s) · last activity "/>
                                                <Run Text="{Binding Dto.LastActivityAt, StringFormat='dd MMM yyyy'}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Tag chips -->
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Tags}" VerticalAlignment="Top">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="10" Padding="10,4" Margin="4,0,0,0"
                                                            Background="{StaticResource LightPink}"
                                                            BorderBrush="{StaticResource BorderPink}" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource DeepPink}"/>
                                                            <TextBlock Text=" ✕" FontSize="10" Margin="6,0,0,0" Cursor="Hand"
                                                                       Foreground="{StaticResource TextSecondary}">
                                                                <TextBlock.InputBindings>
                                                                    <MouseBinding MouseAction="LeftClick"
                                                                                  Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                                                  CommandParameter="{Binding}"/>
                                                                </TextBlock.InputBindings>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>

                                    <!-- Add tag row -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource InputBox}" Margin="0,0,8,0"
                                                 Text="{Binding NewTagText, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding AddTagCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                                Content="+ Tag" Command="{Binding AddTagCommand}"/>
                                    </Grid>

                                    <!-- Expanded messages -->
                                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Messages}"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderPink}" BorderThickness="0,1,0,0"
                                                        Padding="0,8,0,0" Margin="0,4,0,0">
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource SubText}">
                                                            <Run Text="{Binding Type}" FontWeight="SemiBold"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding Direction}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding OccurredAt, StringFormat='dd MMM yyyy HH:mm'}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding LoggedBy}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Body}" Style="{StaticResource BodyText}"
                                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Status + Close -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource SubText}" VerticalAlignment="Center"/>
            <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Content="Close" IsCancel="True" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
